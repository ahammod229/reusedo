# -----------------------------------------------------------------------------
# REUSEDO ENVIRONMENT VARIABLES (.env.example)
# -----------------------------------------------------------------------------

# FRONTEND VARIABLES
VITE_API_URL="http://localhost:4000/api"

# Firebase (Client)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Supabase (Client Realtime)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# BACKEND VARIABLES
PORT=4000
NODE_ENV="development"
CLIENT_URL="http://localhost:5173"

# Firebase Admin (Server)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Replace newlines with \n in the private key string
FIREBASE_PRIVATE_KEY=""

# Supabase (Server & Database)
SUPABASE_URL=""
# ONLY use the Service Role Key on the backend server for elevated access
SUPABASE_SERVICE_ROLE_KEY=""

# -----------------------------------------------------------------------------
# NEW — UI / data layer (apps/web)
# -----------------------------------------------------------------------------
# Mock data is ON by default. Set to "false" once apiSource.ts is implemented.
VITE_USE_MOCK="true"
# DEV ONLY: lets you open every screen without Firebase/backend (ignored in production builds).
VITE_UI_PREVIEW="false"
# Google Ad Manager / AdX network code (e.g. 12345678). Empty = placeholder ad cards.
VITE_ADMANAGER_NETWORK_CODE=""

# -----------------------------------------------------------------------------
# NEW — server-side integrations (apps/api). NEVER prefix these with VITE_.
# -----------------------------------------------------------------------------
# Gemini (AI post drafts) — free tier has per-minute/day limits; see BUILD_GUIDE §6
GEMINI_API_KEY=""
# Transactional email for the 6-digit verification code (Resend or Brevo)
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="ReuseDo <no-reply@yourdomain>"
# Steadfast Courier merchant API
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""
