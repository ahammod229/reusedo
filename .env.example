# Public client settings for the web build (apps/web). Copy to .env.local for development.

# Firebase (sign-in) — Project settings → General → Your apps
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Supabase (data) — Project settings → API. The anon key is public; RLS protects the data.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Local development only: use sample data instead of Supabase. Ignored in production builds.
VITE_USE_MOCK="false"

# Optional: map tiles (defaults to OpenStreetMap, fine for light use)
VITE_MAP_TILE_URL=""

# ── Edge Function secrets are NOT set here. Set them with:  supabase secrets set NAME=value ──
#   FIREBASE_PROJECT_ID, FIREBASE_SERVICE_ACCOUNT (JSON), ALLOWED_ORIGINS, RESEND_API_KEY, EMAIL_FROM,
#   EMAIL_CODE_PEPPER, GEMINI_API_KEY, STEADFAST_API_KEY, STEADFAST_SECRET_KEY
