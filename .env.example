# -----------------------------------------------------------------------------
# REUSEDO ENVIRONMENT VARIABLES — copy to .env at the repo root
# Values prefixed VITE_ end up in the browser bundle. Never put secrets there.
# -----------------------------------------------------------------------------

# --- Web (apps/web) -----------------------------------------------------------
VITE_API_URL="http://localhost:4000/api"

# Mock data is ON by default so the UI works without a backend. Set "false" to use the API.
VITE_USE_MOCK="true"
# DEV ONLY: opens every screen without Firebase/backend (ignored in production builds).
VITE_UI_PREVIEW="false"

# Firebase (client) — sign-in only
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
# Local only: use the Firebase Auth emulator instead of a real project.
# VITE_FIREBASE_AUTH_EMULATOR="http://127.0.0.1:9099"

# Map tiles for the feed map and location picker. Empty = OpenStreetMap (fine for
# development, not for full production traffic). E.g. Barikoi or MapTiler:
# https://.../{z}/{x}/{y}.png?key=...
VITE_MAP_TILE_URL=""
VITE_MAP_ATTRIBUTION=""

# --- API (apps/api) -----------------------------------------------------------
PORT=4000
NODE_ENV="development"
CLIENT_URL="http://localhost:5173"
# Optional second allowed origin (e.g. a separate admin domain).
ADMIN_URL=""

# Supabase (database + storage). Only the API talks to it, with the service role.
# Local: run `supabase start` at the repo root, then `supabase status -o env`:
#   SUPABASE_URL = API_URL (http://127.0.0.1:55321), SUPABASE_SERVICE_ROLE_KEY = SERVICE_ROLE_KEY
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Firebase Admin. FIREBASE_PROJECT_ID alone is enough to verify sign-ins; the
# service account is needed to mark emails verified and delete accounts.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Replace newlines with \n in the private key string
FIREBASE_PRIVATE_KEY=""
# Local only, with the auth emulator: FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"

# Encrypts the keys entered in Admin → APIs (32 random bytes, base64):
#   openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=""

# Any long random string; mixed into stored email-code and handover-code hashes.
EMAIL_CODE_PEPPER=""

# Outside services. Each can instead be set in Admin → APIs (stored encrypted), which
# takes precedence over these.
# Email codes (Resend). Without a key the code is printed to the API log in development.
RESEND_API_KEY=""
EMAIL_FROM="ReuseDo <no-reply@yourdomain.com>"
# Gemini (AI post drafts)
GEMINI_API_KEY=""
# Steadfast Courier merchant API
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""
