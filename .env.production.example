# -----------------------------------------------------------------------------
# REUSEDO ENVIRONMENT VARIABLES (.env.production.example)
# Rename this file to .env.production and populate the values in your CI/CD
# -----------------------------------------------------------------------------

# FRONTEND VARIABLES
VITE_API_URL="https://api.reusedo.com/api"

# Firebase (Client)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Supabase (Client Realtime)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# BACKEND VARIABLES
PORT=4000
NODE_ENV="production"
CLIENT_URL="https://www.reusedo.com"

# Firebase Admin (Server)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Replace newlines with \n in the private key string
FIREBASE_PRIVATE_KEY=""

# Supabase (Server & Database)
SUPABASE_URL=""
# ONLY use the Service Role Key on the backend server for elevated access
SUPABASE_SERVICE_ROLE_KEY=""
